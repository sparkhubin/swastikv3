# ==========================================
# Swastik Supermarket - Environment Configuration
# ==========================================

# Port for the Node.js Express + Vite Dev Server
PORT=3000
NODE_ENV=production

# Base URL of your deployed application (Optional)
DATABASE_URL=./swastik_local.db

# ==========================================
# Database Configuration
# ==========================================
# Leave empty or omit to automatically use the high-performance local SQLite Database (swastik_local.db)
# Set to a valid connection string to use PostgreSQL instead.

# ==========================================
# Mobile & Desktop API Client Configuration
# ==========================================
# Only required for local React/Capacitor apps to target a live API endpoint.
# Leave blank when running the unified local web development server.
VITE_API_URL= http://0.0.0.0:3000 #https://swastiksupermarket.com 

# ==========================================
# Google Maps Platform Configuration
# ==========================================
# Optional: Injected into client-side build
GOOGLE_MAPS_PLATFORM_KEY=

# ==========================================
# Cashfree Payment Gateway Configuration
# ==========================================
# Note: If values are empty, the payment gateway will operate in graceful sandbox simulator mode.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=TEST

# ==========================================
# WhatsApp Meta Cloud API Configuration
# ==========================================
# Note: If values are empty, messages are beautifully logged to terminal in simulated mode.
META_WHATSAPP_PHONE_NUMBER_ID=1023278860879885
META_WHATSAPP_ACCESS_
META_WHATSAPP_TEMPLATE_NAME=reference_no

# ==========================================
# WhatsApp Twilio API Configuration (Secondary Fallback)
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ==========================================
# Cloudflare R2 Cloud Storage Configuration
# ==========================================
# Note: If values are empty, file uploads will automatically save locally to the /public/uploads/ folder.
CLOUDFLARE_R2_ACCOUNT_ID=8440fdd40e316d9bd210e4eee07d191b
CLOUDFLARE_R2_ACCESS_KEY_ID=dcd122a84ec7061573acfe882f9519b2
CLOUDFLARE_R2_SECRET_ACCESS_KEY=71f1573349706e79f9f23d00f63e9a855898fbf07f4ab02c929aacd6f7aeee35
CLOUDFLARE_R2_BUCKET_NAME=swastikmarket
CLOUDFLARE_R2_PUBLIC_URL=https://pub-dff3bfe594f24edf82210ee71e8c1d8e.r2.dev
